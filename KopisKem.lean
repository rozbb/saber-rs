def kem.KemSecretKey.generate
  {T2 : Type} (L : Std.Usize) (MU : Std.Usize) (rand_coreCryptoRngInst :
  rand_core.CryptoRng T2) (rng : T2) :
  Result ((kem.KemSecretKey L) × T2)
